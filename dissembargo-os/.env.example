# =============================================================================
# Supabase (required for authentication and database)
# =============================================================================
# Project URL from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key (NOT the publishable key — this codebase uses ANON_KEY only)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never expose to the browser
# Required for: Gmail sync cron, AI processing, DISABLE_AUTH dev mode
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Application
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Authentication mode
# =============================================================================
# Set both to false for real Supabase email/password login.
# Set both to true ONLY for local dev without logging in (requires service role key).
DISABLE_AUTH=false
NEXT_PUBLIC_DISABLE_AUTH=false

# =============================================================================
# Gmail OAuth (Settings → Integrations)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# OpenAI (email classification)
# =============================================================================
OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# Cron (Vercel production — secures /api/cron/* endpoints)
# =============================================================================
CRON_SECRET=your-random-cron-secret

# =============================================================================
# Optional: auth verification script (scripts/verify-auth.mjs)
# =============================================================================
# TEST_AUTH_EMAIL=you@example.com
# TEST_AUTH_PASSWORD=your-password
