# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application (required for OAuth callbacks and production redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Cron job authentication (Vercel Cron — set in Vercel project settings)
CRON_SECRET=your-random-cron-secret

# Vercel sets NODE_ENV=production automatically in deployed environments.
# All Supabase variables above are required for production deployment.
